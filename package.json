{
  "name": "design-portfolio-tools",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "tools/portfolio-studio-electron",
    "tools/photo-processor-electron"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:electron": "node tools/portfolio-electron-shared/tests/run-tests.cjs",
    "start:studio": "npm start --workspace @portfolio/studio",
    "start:processor": "npm start --workspace @portfolio/processor",
    "build:electron": "npm run build --workspaces",
    "package:electron": "npm run package --workspaces",
    "qa:browser": "node --import tsx tools/portfolio-electron-shared/qa/browser-smoke.ts",
    "qa:packages": "node tools/portfolio-electron-shared/qa/package-smoke.cjs",
    "qa:native": "node --import tsx tools/portfolio-electron-shared/qa/native-smoke.ts",
    "benchmark:electron": "node --import tsx tools/portfolio-electron-shared/qa/benchmark.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.1.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
