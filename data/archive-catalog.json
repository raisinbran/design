  "sourceHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <!-- Google tag (gtag.js) -->\n  <script async src=\"https://www.googletagmanager.com/gtag/js\"></script>\n  <script>\n    window.dataLayer = window.dataLayer || [];\n    function gtag(){dataLayer.push(arguments);}\n    gtag('js', new Date());\n\n    gtag('config', 'G-NYT47YF2F7');\n  </script>\n\n  <title>Archive | Brandon J. Chen</title>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n  <meta name=\"author\" content=\"Brandon J. Chen\">\n<meta name=\"description\" content=\"Creative design portfolio and selected projects by Brandon J. Chen.\">\n  <link rel=\"shortcut icon\" type=\"image/x-icon\" href=\"favicon.ico\" />\n  <!--Font Awesome Brand Icons: --><link rel=\"stylesheet\" href=\"css/site-engineering.css\">\n\n\n  \n\n\n\n\n\n\n  \n\n\n\n\n\n<link rel=\"stylesheet\" href=\"css/site-shared.css?v=20261026-previews\">\n  <link rel=\"stylesheet\" href=\"css/site-section-intro.css\">\n</head>\n<body class=\"archive-2026 engineering-option-a\">\n\n<header class=\"site-nav-2026\"><nav class=\"nav-inner\" aria-label=\"Primary\">\n<a class=\"nav-brand\" href=\"index.html\" aria-label=\"Brandon J. Chen home\"><span class=\"nav-logo\" aria-hidden=\"true\"><img src=\"assets/homepage-2026/grape-default.png\" alt=\"\" width=\"64\" height=\"64\"><img class=\"hover\" src=\"assets/homepage-2026/grape-hover.png\" alt=\"\" width=\"64\" height=\"64\"></span><span><span class=\"nav-name\">Brandon J. Chen</span></span></a>\n<div class=\"nav-links\"><a href=\"engineeringdesign.html\">Engineering</a><a href=\"photography.html\">Photography</a><a href=\"creativedesign.html\" aria-current=\"page\">Archive</a></div>\n</nav></header>\n<header class=\"site-section-intro site-section-intro--archive\" aria-label=\"Archive introduction\">\n  <h1>Archive</h1>\n  <p class=\"site-section-description\">Past work from a past life</p>\n</header>\n\n<main id=\"archive-main\" class=\"pilot-main\" tabindex=\"-1\">\n<div id=\"pilot-projects\">\n<details class=\"project\" id=\"collapseArt\">\n<summary class=\"project-header\" style=\"min-height:10em\">\n<span class=\"project-header-bg\" style=\"background-image:url(&quot;images/Creative/The Cost v.1.0_th.jpg&quot;);background-position:50% 30%;background-size:cover\" aria-hidden=\"true\"></span>\n<span class=\"project-header-shade\" aria-hidden=\"true\"></span>\n<span class=\"project-header-text\">Art</span>\n<span class=\"project-chevron-wrap\" aria-hidden=\"true\"><span class=\"project-chevron\"></span></span>\n</summary>\n<div class=\"project-body\"><h2>Art</h2><hr class=\"project-title-divider\"><div class=\"project-gallery\" data-justified-gallery><figure class=\"project-media\" ><img src=\"images/Creative/The Cost v.1.0 sd.jpg\" alt=\"2018. Inkscape/Adobe Illustrator.\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">2018. Inkscape/Adobe Illustrator.</span></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Creative/Brantor, Arnaskor icon_sd.jpg\" alt=\"2012. Pencil\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">2012. Pencil</span></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Creative/IMG_3092_edit-B_sd.jpg\" alt=\"Deering Library\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Deering Library</span><small>2015. Pencil.</small></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Creative/IMG_3035_sd.jpg\" alt=\"Deering Library reference\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Deering Library reference</span></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Creative/IMG_3036_edit.jpg\" alt=\"Scrap sculpture\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Scrap sculpture</span><small>2015. Charcoal</small></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Creative/IMG_2984_edit_sd.jpg\" alt=\"Scrap sculpture reference\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Scrap sculpture reference</span></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Creative/Forgotten 2nd Map v.1.1.7 icon.jpg\" alt=\"2012. Pencil/Adobe Photoshop\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">2012. Pencil/Adobe Photoshop</span></figcaption></figure></div></div>\n</details>\n<details class=\"project\" id=\"collapseID\">\n<summary class=\"project-header\" style=\"min-height:8em\">\n<span class=\"project-header-bg\" style=\"background-image:url(&quot;images/Ind Dsgn/Furniture 1_sd.jpg&quot;);background-position:100% 40%;background-size:cover\" aria-hidden=\"true\"></span>\n<span class=\"project-header-shade\" aria-hidden=\"true\"></span>\n<span class=\"project-header-text\">Industrial Design</span>\n<span class=\"project-chevron-wrap\" aria-hidden=\"true\"><span class=\"project-chevron\"></span></span>\n</summary>\n<div class=\"project-body\"><h2>Industrial Design</h2><p class=\"lead\">Sketches, CAD, &amp; renderings</p><hr class=\"project-title-divider\"><div class=\"project-gallery\" data-justified-gallery><figure class=\"project-media\" data-display-ratio=\"1\" data-crop-mode=\"square\"  style=\"--media-position:15% 90%\"><img src=\"images/325/Toothbrush construction.jpg\" alt=\"Toothbrush\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Toothbrush</span><small>SolidWorks</small></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/325/Chen_Toothbrush_Rend_f_edit_th.jpg\" alt=\"Toothbrush\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Toothbrush</span><small>SolidWorks</small></figcaption></figure>\n<figure class=\"project-media\" data-display-ratio=\"1\" data-crop-mode=\"square\"  style=\"--media-position:50% 25%\"><img src=\"images/325/method - Side.jpg\" alt=\"Method shampoo bottle reference\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Method shampoo bottle reference</span></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/325/Chen_MethodBottleRend_e_edited_b_sd.jpg\" alt=\"Method shampoo bottle\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Method shampoo bottle</span><small>SolidWorks</small></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/325/Coca-Cola-OGB.jpg\" alt=\"Cola bottle reference image\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Cola bottle reference image</span></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/325/Chen_BottleRend_c_sd.jpg\" alt=\"Customized cola bottle\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Customized cola bottle</span><small>SolidWorks</small></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Ind Dsgn/Furniture Boards 1_sd.jpg\" alt=\"Wicker stool, prior art board\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Wicker stool, prior art board</span></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Ind Dsgn/Furniture Boards 2_sd.jpg\" alt=\"Wicker stool, mood board\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Wicker stool, mood board</span></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Ind Dsgn/Furniture merge_sd.jpg\" alt=\"Wicker stool, concept board\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Wicker stool, concept board</span><small>SolidWorks</small></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Ind Dsgn/Furniture Design Stool B Render B crop_sd.jpg\" alt=\"Wicker stool product rendering\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Wicker stool product rendering</span><small>SolidWorks</small></figcaption></figure>\n<figure class=\"project-media\" ><img src=\"images/Ind Dsgn/Furniture 1_sd.jpg\" alt=\"Wicker stool product sketch\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"caption-main\">Wicker stool product sketch</span></figcaption></figure></div></div>\n</details>\n</div>\n</main>\n<footer class=\"footer-2026\" aria-label=\"Site footer\">\n  <div class=\"footer-2026-inner\">\n    <div class=\"footer-2026-identity\">\n      <span>© 2026 Brandon J. Chen</span>\n    </div>\n    <div class=\"footer-2026-links\" aria-label=\"Social profiles\">\n      <a class=\"footer-2026-social\" href=\"https://linkedin.com/in/branjchen/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Brandon J. Chen on LinkedIn\" title=\"LinkedIn\"><img src=\"assets/icons/linkedin.svg\" width=\"22\" height=\"22\" alt=\"\" aria-hidden=\"true\"></a>\n      <a class=\"footer-2026-social\" href=\"https://github.com/raisinbran\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Brandon J. Chen on GitHub\" title=\"GitHub\"><img src=\"assets/icons/github.svg\" width=\"22\" height=\"22\" alt=\"\" aria-hidden=\"true\"></a>\n    </div>\n  </div>\n</footer>\n\n<script src=\"js/archive-photo-settings.js\"></script>\n<script src=\"js/engineering-gallery.js\"></script>\n<script src=\"js/site-image-policy.js\" defer></script>\n</body>\n</html>\n",
